# Copie este arquivo para .env e ajuste os valores

# Porta do servidor
PORT=3000

# Segredo da sessão — troque por um valor aleatório e secreto em produção
SESSION_SECRET=troque-por-um-valor-aleatorio-secreto

# Ambiente: "production" ativa cookies seguros (HTTPS)
NODE_ENV=development

# Banco de dados MySQL (usado pelo config/pool_conexoes.js)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eco_companion
DB_POOL_LIMIT=10
